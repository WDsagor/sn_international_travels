generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  fullName      String
  phone         String
  email         String    @unique
  password      String
  role          Role      @default(Staff)
  status        Status    @default(active)
  joiningDate   DateTime?
  monthlySalary Float?
  address       String?
  totalProfit   Float     @default(0)

  tickets       Ticket[]
  visa          VisaInfo[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Client {
  id             String   @id @default(uuid())
  clientType     String   @default("Individual")
  phone          String   @unique
  fullName       String
  email          String?  @unique
  company        String?
  openingBalance Float    @default(0)
  address        String?
  status         Status   @default(active)

payments       Payment[]
  tickets        Ticket[]
  visa          VisaInfo[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Ticket {
  id           String    @id @default(uuid())
  pnrCode      String    
  ticketType   String
  issueDate    DateTime
  passengerName String
  route        String
  travelDate   DateTime?
  totalPax     String       
  airline      String
  status       String    @default("Issued")
  netCost      Float
  clientPrice  Float
  serviceCharge Float     @default(0)
  netProfit    Float 

  issuedById   String
  issuedBy     User      @relation(fields: [issuedById], references: [id])

  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
model VisaInfo {
  id                String @id @default(uuid())
  issueDate              DateTime
  clientId          String
  issuedById        String
  passportName      String
  passportNumber    String
  numberOfPassport  Float?
  passportImage     String?
  visaCategory      String
  visaType          String
  agencyName        String?
  submissionDate    DateTime
  visaCountry       String
  visaDetails       String?
  status            String    @default("Submitted")
  netCost           Float
  clientPrice       Float
  netProfit         Float 

  issuedBy          User @relation(fields: [issuedById], references: [id])

  client            Client    @relation(fields: [clientId], references: [id])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt


}
model Payment {
  id            String   @id @default(uuid())
  amount        Float    
  paymentDate   DateTime @default(now()) 
  paymentMethod String  
  trxId         String?  
  note          String? 
  type          String?

  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
enum Role {
  Accounts
  Manager
  Admin
  Staff
}

enum Status {
  active
  Inactive
}

